# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nova_commerce?schema=public"

# AWS S3 Configuration (for product images)
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="nova-commerce-images"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Platform URLs
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# Payment Providers - Paystack
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET="whsk_xxx"

# Payment Providers - Hubtel
HUBTEL_CLIENT_ID="your-client-id"
HUBTEL_CLIENT_SECRET="your-client-secret"
HUBTEL_MERCHANT_CODE="your-merchant-code"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="Nova Commerce"
SMTP_FROM_EMAIL="noreply@novacommerce.com"

# Optional: Alternative Email Providers
SENDGRID_API_KEY=""
RESEND_API_KEY=""
AWS_SES_REGION=""

# Encryption Key for sensitive data (32 characters)
ENCRYPTION_KEY="12345678901234567890123456789012"

# Node Environment
NODE_ENV="development"
