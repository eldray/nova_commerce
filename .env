# App Configuration
VITE_APP_NAME=Nova Commerce
VITE_APP_URL=http://localhost:3000
VITE_API_URL=/api

# Security & Encryption
# IMPORTANT: Change this to a random 32-character string in production
VITE_ENCRYPTION_KEY=nova-commerce-secret-key-32-chars!
VITE_JWT_SECRET=nova-jwt-secret-super-safe-key-123
VITE_SESSION_SECRET=nova-session-secret-key-456

# Database (If using a local DB, otherwise these are defaults)
VITE_DATABASE_URL=sqlite:./data/nova-commerce.db

# Email Configuration (Defaults for development)
VITE_EMAIL_FROM=noreply@nova-commerce.local
VITE_EMAIL_HOST=localhost
VITE_EMAIL_PORT=587
VITE_EMAIL_USER=user
VITE_EMAIL_PASSWORD=password

# Payment Gateways (Default test keys)
VITE_STRIPE_PUBLIC_KEY=pk_test_nova_commerce_default
VITE_STRIPE_SECRET_KEY=sk_test_nova_commerce_default
VITE_PAYPAL_CLIENT_ID=default_paypal_client_id
VITE_PAYPAL_CLIENT_SECRET=default_paypal_secret

# Admin/Platform Settings
VITE_PLATFORM_NAME=Nova Commerce Platform
VITE_SUPPORT_EMAIL=support@nova-commerce.local